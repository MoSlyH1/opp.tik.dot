# Copy to .env (Docker) or add to Vercel → Project → Settings → Environment Variables.

# Long random string. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
# Authorized JavaScript origins: http://localhost:8080, http://localhost:5173, https://<your-app>.vercel.app
GOOGLE_CLIENT_ID=

# Optional but recommended: YouTube Data API v3 key. Without it the app uses Internet Archive + curated TikToks.
YOUTUBE_API_KEY=

# Dailymotion search is keyless and on by default (great for European / Arabic TV). 0 to switch off.
DAILYMOTION=1

# Optional official social APIs. Leave empty and that source is simply off.
# Instagram hashtag search: Meta app token + the id of an Instagram Business/Creator account.
META_ACCESS_TOKEN=
IG_USER_ID=
# X API v2 recent search (Basic tier or above).
X_BEARER_TOKEN=
# Reddit app (script type): finds videos posted to r/90s, r/nostalgia, r/2000s...
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Comma-separated emails that see the Curator panel (add TikToks, run ingest).
ADMIN_EMAILS=

# Vercel Cron sends "Authorization: Bearer <CRON_SECRET>" to /api/cron/ingest.
CRON_SECRET=change-me-too

# Vercel/Neon only. Docker sets DATABASE_URL itself.
# DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/opptik?sslmode=require

# 1 in production (HTTPS). 0 for localhost.
COOKIE_SECURE=0

# Only for local dev without Google. Ignored on Vercel.
DEV_LOGIN=0

# Hours between ingest runs for the Docker worker.
INGEST_INTERVAL_HOURS=6

# ---- v7: HLS on a CDN (only the transcode job needs these; see README "Fast video")
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=opp-video
S3_KEY=
S3_SECRET=
# Free: your Cloudflare Worker URL (cdn-worker/). Or a custom domain on the bucket.
CDN_BASE=https://opp-video.YOUR-SUBDOMAIN.workers.dev

# v11: Cloudflare Pages address that serves the small hosted clips (the `clips` branch)
CLIPS_BASE=
